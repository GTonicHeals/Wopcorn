// TSConfig for the unit tests, which tsconfig.app.json excludes so that production
// type-checking never depends on test-only types.
{
  "extends": "./tsconfig.app.json",
  "include": ["env.d.ts", "src/**/__tests__/**/*"],
  "exclude": [],
  "compilerOptions": {
    "types": ["node"],

    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.vitest.tsbuildinfo"
  }
}
